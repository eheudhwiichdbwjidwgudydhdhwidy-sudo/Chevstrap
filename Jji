-- Utility to create toggle rows
local function makeToggle(text, startY, initial, callback)
    local lbl = Instance.new("TextLabel")
    lbl.Parent = mainFrame
    lbl.Position = UDim2.new(0, 10, 0, startY)
    lbl.Size = UDim2.new(0, 220, 0, 30)
    lbl.BackgroundTransparency = 1
    lbl.Font = Enum.Font.SourceSans
    lbl.TextSize = 16
    lbl.TextColor3 = Color3.new(1,1,1)
    lbl.Text = text
    lbl.TextXAlignment = Enum.TextXAlignment.Left

    local btn = Instance.new("TextButton")
    btn.Parent = mainFrame
    btn.Position = UDim2.new(0, 240, 0, startY)
    btn.Size = UDim2.new(0, 80, 0, 30)
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 14
    btn.Text = initial and "ON" or "OFF"
    btn.BackgroundColor3 = initial and Color3.fromRGB(50,140,50) or Color3.fromRGB(140,50,50)
    btn.MouseButton1Click:Connect(function()
        local new = not (btn.Text == "ON")
        btn.Text = new and "ON" or "OFF"
        btn.BackgroundColor3 = new and Color3.fromRGB(50,140,50) or Color3.fromRGB(140,50,50)
        callback(new)
    end)
    return btn
end

