-- Basic visual spam effect (client-side)
local function doSpamVisual()
    -- create a small ephemeral part at mouse position for effect
    local mouse = player:GetMouse()
    local pos = mouse.Hit and mouse.Hit.p or (camera.CFrame.Position + camera.CFrame.LookVector * 10)
    local part = Instance.new("Part")
    part.Size = Vector3.new(0.2,0.2,0.2)
    part.Anchored = true
    part.CanCollide = false
    part.CFrame = CFrame.new(pos)
    part.Transparency = 0.3
    part.Parent = workspace
    game:GetService("Debris"):AddItem(part, 0.35)
end

-- Auto-swing simulation (local only)
local lastSwing = 0
local swingInterval = 0.25 -- seconds between local swings
local function tryAutoSwing(dt)
    if not settings.autoSwing then return end
    local now = tick()
    if now - lastSwing >= swingInterval then
        lastSwing = now
        -- play a local animation (if tool present, play its animation)
        -- This simple approach: brief camera shake to simulate swing
        local origCFrame = camera.CFrame
        camera.CFrame = camera.CFrame * CFrame.Angles(0.02, 0, 0)
        wait(0.03)
        camera.CFrame = origCFrame
        -- Optionally show a visual hit marker
        StarterGui:SetCore("SendNotification", {Title="Auto Swing"; Text="(local simulation)"; Duration=0.6})
    end
end

-- Find nearest target (client-side only, does NOT damage others)
local function findNearestHumanoid(range)
    local nearest, dist = nil, range or math.huge
    for _, model in ipairs(workspace:GetDescendants()) do
        if model:IsA("Model") and model ~= character and model:FindFirstChild("Humanoid") and model:FindFirstChild("HumanoidRootPart") then
            local hrp = model.HumanoidRootPart
            local d = (hrp.Position - (character and character:FindFirstChild("HumanoidRootPart") and character.HumanoidRootPart.Position or camera.CFrame.Position)).Magnitude
            if d < dist and d <= (settings.autoLockRange or 50) then
                dist = d
                nearest = model
            end
        end
    end
    return nearest
end

-- Auto-lock camera to nearest
local autoLockConn
autoLockConn = RunService.RenderStepped:Connect(function(dt)
    -- update references
    character = player.Character or player.CharacterAdded:Wait()
    if settings.autoSwing then
        tryAutoSwing(dt)
    end
    if settings.spamClick then
        -- spam a visual effect around the mouse quickly (client only)
        if math.random() < 0.35 then
            doSpamVisual()
        end
    end
    if settings.speedEnabled and character and character:FindFirstChild("Humanoid") then
        character.Humanoid.WalkSpeed = settings.speedValue
    end
    if settings.autoLock and character and character:FindFirstChild("HumanoidRootPart") then
        local target = findNearestHumanoid(settings.autoLockRange)
        if target and target:FindFirstChild("HumanoidRootPart") then
            local tgt = target.HumanoidRootPart
            -- client-side camera follow: smoothly move camera CFrame toward target
            local targetCFrame = CFrame.new(tgt.Position + Vector3.new(0, 5, 7), tgt.Position)
            camera.CFrame = camera.CFrame:Lerp(targetCFrame, 0.12)
        end
    end
end)

