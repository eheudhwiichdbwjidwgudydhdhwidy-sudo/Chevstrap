end)

-- Final convenience: allow teleport to spawn points with number keys
UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.UserInputType == Enum.UserInputType.Keyboard then
        local key = input.KeyCode.Value
        -- Number keys 1..9 map to teleport saved points 1..9
        if input.KeyCode >= Enum.KeyCode.One and input.KeyCode <= Enum.KeyCode.Nine then
            local idx = tonumber(string.sub(input.KeyCode.Name, -1))
            if settings.teleportPoints[idx] and character and character:FindFirstChild("HumanoidRootPart") then
                character.HumanoidRootPart.CFrame = settings.teleportPoints[idx] + Vector3.new(0,3,0)
            end
        end
    end
end)

